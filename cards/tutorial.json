                { "type": "text", "text": "「個人帳號不能直接貼 Flex JSON，要透過 LIFF 分享才發得出去」", "size": "sm", "color": "#f5f5f5", "wrap": true },
                { "type": "text", "text": "發送方式", "size": "xs", "color": "#94a4b8", "align": "end" } ] },
            { "type": "box", "layout": "vertical", "spacing": "xs", "paddingAll": "12px", "cornerRadius": "10px", "backgroundColor": "#1b2b3d",
