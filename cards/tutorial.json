                { "type": "text", "text": "「底色 #0e1a2a、框 #1b2b3d、強調 #f6a83a、小字 #94a4b8」", "size": "sm", "color": "#f5f5f5", "wrap": true },
                { "type": "text", "text": "配色", "size": "xs", "color": "#94a4b8", "align": "end" } ] },
            { "type": "box", "layout": "vertical", "spacing": "xs", "paddingAll": "12px", "cornerRadius": "10px", "backgroundColor": "#1b2b3d",
              "contents": [
                { "type": "text", "text": "「altText 會出現在聊天列表和通知，要寫成一句看得懂的摘要」", "size": "sm", "color": "#f5f5f5", "wrap": true },
                { "type": "text", "text": "altText", "size": "xs", "color": "#94a4b8", "align": "end" } ] },
            { "type": "separator", "color": "#2a3a4f", "margin": "lg" },
