{
  "title": "LINE 圖卡教學",
  "messages": [
    {
      "type": "flex",
      "altText": "【教學】個人帳號怎麼在群組發 Flex 圖卡",
      "contents": {
        "type": "bubble",
        "size": "mega",
        "body": {
          "type": "box", "layout": "vertical", "spacing": "sm", "paddingAll": "18px", "backgroundColor": "#0e1a2a",
          "contents": [
            { "type": "text", "text": "LINE 圖卡教學", "size": "xxs", "color": "#f6a83a", "weight": "bold" },
            { "type": "text", "text": "個人帳號怎麼在群組發圖卡", "size": "xl", "color": "#ffffff", "weight": "bold", "wrap": true },
            { "type": "text", "text": "就是群組摘要那種可以按的卡片", "size": "xs", "color": "#94a4b8", "wrap": true },
            { "type": "separator", "color": "#2a3a4f", "margin": "lg" },
            {
              "type": "box", "layout": "vertical", "spacing": "md", "margin": "lg",
              "contents": [
                { "type": "box", "layout": "baseline", "spacing": "sm", "contents": [
                  { "type": "text", "text": "1️⃣", "size": "sm", "flex": 0 },
                  { "type": "text", "text": "在 LINE Developers 開一個 LINE Login channel，新增 LIFF，打開 Share target picker", "size": "sm", "color": "#f5f5f5", "wrap": true, "flex": 1 } ] },
                { "type": "box", "layout": "baseline", "spacing": "sm", "contents": [
                  { "type": "text", "text": "2️⃣", "size": "sm", "flex": 0 },
                  { "type": "text", "text": "用 Flex Message Simulator 排卡片，複製 JSON", "size": "sm", "color": "#f5f5f5", "wrap": true, "flex": 1 } ] },
                { "type": "box", "layout": "baseline", "spacing": "sm", "contents": [
                  { "type": "text", "text": "3️⃣", "size": "sm", "flex": 0 },
                  { "type": "text", "text": "做一個網頁：liff.init 之後呼叫 liff.shareTargetPicker(訊息)", "size": "sm", "color": "#f5f5f5", "wrap": true, "flex": 1 } ] },
                { "type": "box", "layout": "baseline", "spacing": "sm", "contents": [
                  { "type": "text", "text": "4️⃣", "size": "sm", "flex": 0 },
                  { "type": "text", "text": "網頁放 GitHub Pages，網址填進 LIFF 的 Endpoint", "size": "sm", "color": "#f5f5f5", "wrap": true, "flex": 1 } ] },
                { "type": "box", "layout": "baseline", "spacing": "sm", "contents": [
                  { "type": "text", "text": "5️⃣", "size": "sm", "flex": 0 },
                  { "type": "text", "text": "在 LINE 裡開 liff.line.me 連結 → 選群組 → 卡片就用你自己的名字發出去", "size": "sm", "color": "#f5f5f5", "wrap": true, "flex": 1 } ] }
              ]
            }
          ]
        },
        "footer": {
          "type": "box", "layout": "vertical", "spacing": "sm", "paddingAll": "16px", "paddingTop": "4px", "backgroundColor": "#0e1a2a",
          "contents": [
            { "type": "box", "layout": "vertical", "paddingAll": "12px", "cornerRadius": "8px", "backgroundColor": "#f6a83a",
              "action": { "type": "uri", "label": "Flex 排版工具", "uri": "https://developers.line.biz/flex-simulator/" },
              "contents": [ { "type": "text", "text": "Flex 排版工具", "size": "sm", "align": "center", "color": "#0e1a2a", "weight": "bold" } ] },
            { "type": "box", "layout": "vertical", "paddingAll": "10px", "cornerRadius": "8px", "borderWidth": "1px", "borderColor": "#f6a83a",
              "action": { "type": "uri", "label": "shareTargetPicker 文件", "uri": "https://developers.line.biz/en/reference/liff/#share-target-picker" },
              "contents": [ { "type": "text", "text": "shareTargetPicker 文件", "size": "sm", "align": "center", "color": "#f6a83a", "weight": "bold" } ] }
          ]
        }
      }
    },
    {
